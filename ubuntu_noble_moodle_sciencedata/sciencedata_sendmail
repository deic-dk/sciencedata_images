#!/usr/bin/php
<?php
// PHP's sendmail_path in this image: Moodle (no SMTP host set) sends with PHP's
// mail(), which pipes each finished message here. It goes to the pod owner's
// ScienceData server (user_pods api/pod-mail; the pod network's address login
// makes the call the owner's), which sends it with its own mail settings -
// sender replaced by its no-reply address, recipients, size and rate limited.
// No mail credentials in the pod. Recipients: the To, Cc and Bcc headers (as
// 'sendmail -t'); arguments (-t, -i, -f sender) are ignored.

$raw = stream_get_contents(STDIN);
$parts = preg_split('/\r?\n\r?\n/', (string)$raw, 2);
if (count($parts) !== 2) {
	fwrite(STDERR, "sciencedata_sendmail: not a mail message\n");
	exit(64);
}
$to = [];
foreach (preg_split('/\r?\n(?![ \t])/', $parts[0]) as $header) {
	if (!preg_match('/^(To|Cc|Bcc):(.*)$/is', $header, $m)) {
		continue;
	}
	// display names may contain anything, also '@': drop quoted strings and
	// comments, then take <address> where given, else the bare address
	$list = preg_replace(['/"(?:[^"\\\\]|\\\\.)*"/s', '/\((?:[^()\\\\]|\\\\.)*\)/s'], ' ', $m[2]);
	foreach (explode(',', $list) as $item) {
		if (preg_match('/<([^<>\s]+@[^<>\s]+)>/', $item, $a) || preg_match('/([^\s<>;:]+@[^\s<>;:]+)/', $item, $a)) {
			$to[] = $a[1];
		}
	}
}
$to = array_values(array_unique($to));
if ($to === []) {
	fwrite(STDERR, "sciencedata_sendmail: no recipients\n");
	exit(64);
}

$proto = 'https';
$env = @file_get_contents('/etc/moodle_backup.env');
if ($env !== false && preg_match("/^HOME_SERVER_PROTOCOL='?(https?)'?/m", $env, $p)) {
	$proto = $p[1];
}
$ch = curl_init($proto . '://sciencedata/index.php/apps/user_pods/api/pod-mail');
curl_setopt_array($ch, [
	CURLOPT_POST => true,
	CURLOPT_POSTFIELDS => json_encode(['to' => $to, 'message' => base64_encode($raw)]),
	CURLOPT_HTTPHEADER => ['Content-Type: application/json'],
	CURLOPT_RETURNTRANSFER => true,
	CURLOPT_TIMEOUT => 60,
	CURLOPT_SSL_VERIFYPEER => false, // the home server's internal address
	CURLOPT_SSL_VERIFYHOST => 0,
]);
$body = curl_exec($ch);
$status = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
if ($status === 200) {
	exit(0);
}
$message = $body === false ? curl_error($ch) : ((json_decode((string)$body, true)['message'] ?? '') ?: "HTTP $status");
fwrite(STDERR, 'sciencedata_sendmail: mail to ' . implode(', ', $to) . " not sent: $message\n");
exit($status === 429 || $status >= 500 || $status === 0 ? 75 : 69); // EX_TEMPFAIL / EX_UNAVAILABLE
